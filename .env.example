# PostHog. Values come from https://us.posthog.com/settings/project#snippet
# These are PUBLIC_ on purpose: the project token is meant to ship to the browser.
# The deploy environment must set these too, otherwise analytics silently no-ops.
PUBLIC_POSTHOG_PROJECT_TOKEN=phc_xxx
# Managed reverse proxy, so events are first-party and less likely to be blocked
PUBLIC_POSTHOG_HOST=https://ph.trioassinaturas.com.br
# Needed because of the proxy, so toolbar/replay links point back at PostHog
PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com
