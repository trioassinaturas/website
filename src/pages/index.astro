---
import Layout from "../layouts/Layout.astro"
import Hero from "../components/Hero.astro"
import Features from "../components/Features.astro"
import Platform from "../components/Platform.astro"
import Clients from "../components/Clients.astro"
import Story from "../components/Story.astro"
import CTA from "../components/CTA.astro"
import { organization, softwareApplication, website } from "../lib/schema"
import { FEEDS } from "../lib/feeds"

const site = Astro.site!
---

<Layout
  feed={FEEDS.root}
  schema={[organization(site), website(site), softwareApplication(site)]}
>
  <Hero />
  <Features />
  <Platform />
  <Clients />
  <Story />
  <CTA />
</Layout>
