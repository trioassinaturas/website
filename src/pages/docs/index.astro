---
import Layout from "../../layouts/Layout.astro"
import CTA from "../../components/CTA.astro"
import DocsSearch from "../../components/docs/DocsSearch.astro"
import { getDocsNav } from "../../lib/docs"
import { breadcrumbs, collectionPage } from "../../lib/schema"
import "../../styles/docs.css"

const nav = await getDocsNav()
const pageCount = nav.flat.length
const first = nav.flat[0]

const description =
  "Como configurar e operar o seu clube de assinatura na Trio: planos, kits, cobranças recorrentes, envios e área do assinante."

const site = Astro.site!
const schema = [
  collectionPage({
    site,
    path: "/docs",
    name: "Documentação Trio Assinaturas",
    description,
    items: nav.flat.map((item) => ({ name: item.title, path: item.url })),
  }),
  breadcrumbs(site, [{ name: "Início", path: "/" }, { name: "Documentação" }]),
]
---

<Layout
  title="Documentação | Trio Assinaturas"
  description={description}
  schema={schema}
>
  <section class="section docs-index">
    <div class="container">
      <p class="section-eyebrow">Documentação</p>
      <h1 class="section-title">Tudo sobre como operar o seu clube na Trio</h1>
      <p class="section-lead">
        {pageCount} páginas cobrindo o caminho completo: montar o catálogo, cobrar
        todos os meses, despachar as caixas e deixar o assinante resolver o que precisa
        sozinho.
      </p>

      <div class="docs-index-search">
        <DocsSearch section="docs-index" />
      </div>

      {
        first && (
          <p class="docs-index-start">
            Primeira vez aqui?{" "}
            <a
              href={first.url}
              data-ph-capture-attribute-cta="docs-start"
              data-ph-capture-attribute-cta-section="docs-index"
              data-ph-capture-attribute-cta-channel="internal"
            >
              Comece pela {first.title.toLowerCase()}
            </a>
            .
          </p>
        )
      }

      <p class="docs-index-start">
        Quer saber o que mudou recentemente? Veja as{" "}
        <a
          href="/novidades"
          data-ph-capture-attribute-cta="docs-changelog"
          data-ph-capture-attribute-cta-section="docs-index"
          data-ph-capture-attribute-cta-channel="internal"
        >
          novidades da plataforma
        </a>
        .
      </p>

      <div class="docs-index-grid">
        {
          nav.groups.map((group, i) => (
            <div
              class="docs-index-card reveal"
              style={`--reveal-delay: ${i * 0.08}s`}
            >
              <h2>{group.label}</h2>
              <ul class="docs-index-card-list">
                {group.items.map((item) => (
                  <li>
                    <a
                      href={item.url}
                      data-ph-capture-attribute-cta="docs-index-link"
                      data-ph-capture-attribute-cta-section="docs-index"
                      data-ph-capture-attribute-cta-channel="internal"
                    >
                      {item.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CTA />
</Layout>

<style>
  /* The CTA section below brings its own top padding. */
  .docs-index {
    padding-bottom: 0;
  }

  .docs-index-start {
    margin-top: 1.5rem;
    color: var(--ink-soft);
  }

  .docs-index-start + .docs-index-start {
    margin-top: 0.5rem;
  }
</style>
