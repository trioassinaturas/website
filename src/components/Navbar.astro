---
import Logo from "./Logo.astro"
import { whatsappLink } from "../config"

const links = [
  { href: "/#funcionalidades", label: "Funcionalidades" },
  { href: "/sobre", label: "Sobre" },
  { href: "/docs", label: "Documentação" },
  { href: "/blog", label: "Blog" },
]
---

<header class="navbar" id="navbar">
  <div class="container navbar-inner">
    <a
      href="/"
      class="navbar-logo"
      aria-label="Trio Assinaturas, página inicial"
    >
      <Logo />
    </a>

    <nav class="navbar-nav" id="navbar-nav" aria-label="Navegação principal">
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
      <a
        class="btn btn-primary navbar-cta"
        href={whatsappLink()}
        target="_blank"
        rel="noopener nofollow"
        data-ph-capture-attribute-cta="demo-request"
        data-ph-capture-attribute-cta-section="navbar"
        data-ph-capture-attribute-cta-channel="whatsapp"
      >
        Solicitar demonstração
      </a>
    </nav>

    <button
      class="navbar-toggle"
      id="navbar-toggle"
      aria-expanded="false"
      aria-controls="navbar-nav"
      aria-label="Abrir menu"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 50;
    /* Held out of the page crossfade so it stays put across navigations. */
    view-transition-name: site-navbar;
    background: color-mix(in srgb, var(--cream) 82%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid transparent;
    transition:
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .navbar.is-scrolled {
    border-bottom-color: var(--border);
    box-shadow: 0 4px 24px rgb(31 38 71 / 0.06);
  }

  .navbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 0.9rem;
  }

  .navbar-logo {
    text-decoration: none;
    flex-shrink: 0;
  }

  .navbar-nav {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .navbar-nav ul {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .navbar-nav ul a {
    color: var(--ink-soft);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    transition: color 0.15s ease;
  }

  .navbar-nav ul a:hover {
    color: var(--blue);
  }

  .navbar-cta {
    padding: 0.6rem 1.25rem;
    font-size: 0.95rem;
  }

  .navbar-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 10px;
    background: none;
    border: none;
    cursor: pointer;
  }

  .navbar-toggle span {
    display: block;
    height: 2.5px;
    border-radius: 2px;
    background: var(--blue-deep);
    transition:
      translate 0.2s ease,
      rotate 0.2s ease,
      opacity 0.2s ease;
  }

  @media (max-width: 51rem) {
    .navbar-toggle {
      display: flex;
    }

    .navbar-nav {
      position: absolute;
      inset: 100% 0 auto 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0.5rem;
      padding: 1rem 1.25rem 1.5rem;
      background: var(--cream);
      border-bottom: 1px solid var(--border);
      box-shadow: 0 24px 40px rgb(31 38 71 / 0.1);
      display: none;
    }

    .navbar-nav.is-open {
      display: flex;
    }

    .navbar-nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .navbar-nav ul a {
      display: block;
      padding: 0.85rem 0.5rem;
      font-size: 1.05rem;
      border-bottom: 1px solid var(--border);
    }

    .navbar-cta {
      margin-top: 0.75rem;
    }

    .navbar-toggle[aria-expanded="true"] span:nth-child(1) {
      translate: 0 7.5px;
      rotate: 45deg;
    }

    .navbar-toggle[aria-expanded="true"] span:nth-child(2) {
      opacity: 0;
    }

    .navbar-toggle[aria-expanded="true"] span:nth-child(3) {
      translate: 0 -7.5px;
      rotate: -45deg;
    }
  }
</style>

<script>
  const navbar = document.getElementById("navbar")!
  const toggle = document.getElementById("navbar-toggle")!
  const nav = document.getElementById("navbar-nav")!

  const onScroll = () =>
    navbar.classList.toggle("is-scrolled", window.scrollY > 8)
  onScroll()
  window.addEventListener("scroll", onScroll, { passive: true })

  toggle.addEventListener("click", () => {
    const open = nav.classList.toggle("is-open")
    toggle.setAttribute("aria-expanded", String(open))
    toggle.setAttribute("aria-label", open ? "Fechar menu" : "Abrir menu")
  })

  nav.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("a")) {
      nav.classList.remove("is-open")
      toggle.setAttribute("aria-expanded", "false")
    }
  })
</script>
