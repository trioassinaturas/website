  posthog.init(token, {
    api_host: apiHost, // managed reverse proxy, so events are first-party
    ui_host: uiHost, // so toolbar/replay links point back at PostHog itself

    // Opts into the latest recommended behaviours. Notably this already gives us
    // capture_pageview: 'history_change', session_recording.strictMinimumDuration,
    // external_scripts_inject_target: 'head', split_storage and the expanded
    // rageclick defaults. Bump the date to adopt future changes deliberately.
    defaults: "2026-05-30",

    // --- Identity: fully anonymous ---
    // No cookies, no localStorage, no sessionStorage. Identity is a rotating
    // privacy-preserving hash computed server-side by PostHog.
    // NOTE: cookieless must also be enabled in project settings, or these
    // events are dropped on ingestion.
    cookieless_mode: "always",
    // Never do person processing, so no person profiles are created at all.
    person_profiles: "never",

    // --- Pageviews & pageleaves ---
    // Both are on via `defaults`, set explicitly so the intent is obvious.
    // 'history_change' also covers in-page anchor navigation (/#funcionalidades).
    capture_pageview: "history_change",
    capture_pageleave: true,

    // --- Autocapture ---
    // Left on so every click/submit is captured without extra code. Elements
    // opt out with class="ph-no-autocapture" or [data-ph-no-autocapture].
    autocapture: true,
    // Frustration signals: clicks that do nothing, and rapid repeat clicks.
    capture_dead_clicks: true,
    rageclick: true,

    // --- Session replay ---
    disable_session_recording: false,

    // --- Error tracking ---
    capture_exceptions: {
      capture_unhandled_errors: true,
      capture_unhandled_rejections: true,
      // Noisy on a marketing site (browser extensions, blocked third parties).
      capture_console_errors: false,
    },

    // --- Heatmaps + web vitals ---
    capture_heatmaps: true,
    capture_performance: { web_vitals: true },
  })
</script>
