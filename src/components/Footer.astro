---
import Logo from "./Logo.astro"
import { CONTACT, whatsappLink } from "../config"

const year = new Date().getFullYear()
---

<footer class="footer" id="contato">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <Logo variant="white" />
        <p>
          A plataforma completa para clubes de assinatura no Brasil. Planos,
          assinantes, pagamentos e envios, tudo em um só lugar.
        </p>
      </div>

      <nav class="footer-col" aria-label="Navegação do rodapé">
        <h3>Navegação</h3>
        <ul>
          <li><a href="/#funcionalidades">Funcionalidades</a></li>
          <li><a href="/#plataforma">Plataforma</a></li>
          <li><a href="/#clientes">Clientes</a></li>
          <li><a href="/sobre">Sobre nós</a></li>
          <li><a href="/docs">Documentação</a></li>
          <li><a href="/blog">Blog</a></li>
          <li><a href="/perguntas-frequentes">Perguntas frequentes</a></li>
        </ul>
      </nav>

      <div class="footer-col">
        <h3>Fale com a gente</h3>
        <ul>
          <li>
            <a
              href={`mailto:${CONTACT.email}`}
              data-ph-capture-attribute-cta="contact"
              data-ph-capture-attribute-cta-section="footer"
              data-ph-capture-attribute-cta-channel="email"
            >
              {CONTACT.email}
            </a>
          </li>
          <li>
            <a
              href={whatsappLink(
                "Olá! Quero saber mais sobre a Trio Assinaturas.",
              )}
              target="_blank"
              rel="noopener"
              data-ph-capture-attribute-cta="contact"
              data-ph-capture-attribute-cta-section="footer"
              data-ph-capture-attribute-cta-channel="whatsapp"
            >
              WhatsApp: {CONTACT.whatsappDisplay}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>
        © {year} Trio Assinaturas. Feito com carinho em Porto Alegre, Brasil.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--blue-deep);
    color: rgb(255 255 255 / 0.85);
    padding-block: clamp(3rem, 2rem + 4vw, 5rem) 2rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 2.5rem;
  }

  .footer-brand p {
    margin-top: 1rem;
    max-width: 34ch;
    font-size: 0.95rem;
    color: rgb(255 255 255 / 0.7);
  }

  .footer-col h3 {
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.55);
    margin-bottom: 1rem;
  }

  .footer-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }

  .footer-col a {
    color: rgb(255 255 255 / 0.85);
    text-decoration: none;
    font-size: 0.95rem;
  }

  .footer-col a:hover {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer-bottom {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(255 255 255 / 0.12);
    font-size: 0.85rem;
    color: rgb(255 255 255 / 0.55);
  }

  @media (max-width: 44rem) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
