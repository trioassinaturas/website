---
/**
 * Search box over the Pagefind index built by `src/integrations/pagefind.ts`.
 *
 * The index is generated from built HTML, so it does not exist under
 * `astro dev`. When it can't be loaded the box explains that instead of
 * failing silently. Use `pnpm build && pnpm preview` to try search locally.
 */
interface Props {
  /** The field's accessible label, and the placeholder unless one is given. */
  label?: string
  /** Shorter placeholder, for when the field sits in a narrow column. */
  placeholder?: string
  /** Distinguishes the landing-page box from the one in the docs layout. */
  section?: string
}

const {
  label = "Buscar na documentação",
  placeholder = label,
  section = "docs",
} = Astro.props

const uid = Math.random().toString(36).slice(2, 8)
const inputId = `docs-search-input-${uid}`
const panelId = `docs-search-panel-${uid}`
---

<div class="docs-search" data-docs-search data-search-section={section}>
  <div class="docs-search-field">
    <svg
      class="docs-search-icon"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <circle cx="11" cy="11" r="7"></circle>
      <path d="m20 20-3.5-3.5"></path>
    </svg>

    <label class="sr-only" for={inputId}>{label}</label>
    <input
      class="docs-search-input"
      id={inputId}
      type="search"
      placeholder={placeholder}
      autocomplete="off"
      role="combobox"
      aria-expanded="false"
      aria-controls={panelId}
      aria-autocomplete="list"
      data-search-input
    />

    <kbd class="docs-search-hint" data-search-hint aria-hidden="true">⌘K</kbd>
  </div>

  <div class="docs-search-panel" id={panelId} hidden data-search-panel>
    <p class="docs-search-status" data-search-status role="status"></p>
    <ul
      class="docs-search-results"
      role="listbox"
      aria-label="Resultados da busca"
      data-search-results
    >
    </ul>
  </div>
</div>

<script>
  interface PagefindSubResult {
    title: string
    url: string
    excerpt: string
  }

  interface PagefindResultData {
    url: string
    excerpt: string
    meta: Record<string, string> & { title?: string }
    sub_results: PagefindSubResult[]
  }

  interface PagefindResult {
    id: string
    data: () => Promise<PagefindResultData>
  }

  interface PagefindApi {
    init: () => Promise<void>
    debouncedSearch: (
      query: string,
      options?: Record<string, unknown>,
      debounceMs?: number,
    ) => Promise<{ results: PagefindResult[] } | null>
  }

  let api: PagefindApi | undefined
  let unavailable = false

  /** Loads the index written into `dist/pagefind/` at build time. */
  async function loadPagefind(): Promise<PagefindApi | undefined> {
    if (api || unavailable) return api

    try {
      // Held in a variable so Vite doesn't try to resolve it at build time:
      // the file only exists after the build has run.
      const url = `${import.meta.env.BASE_URL}pagefind/pagefind.js`
      const loaded = (await import(/* @vite-ignore */ url)) as PagefindApi
      await loaded.init()
      api = loaded
    } catch {
      unavailable = true
    }

    return api
  }

  document
    .querySelectorAll<HTMLElement>("[data-docs-search]")
    .forEach((root) => {
      const input = root.querySelector<HTMLInputElement>("[data-search-input]")!
      const panel = root.querySelector<HTMLElement>("[data-search-panel]")!
      const status = root.querySelector<HTMLElement>("[data-search-status]")!
      const list = root.querySelector<HTMLElement>("[data-search-results]")!
      const hint = root.querySelector<HTMLElement>("[data-search-hint]")!
      const section = root.dataset.searchSection ?? "docs"

      if (!navigator.platform.toLowerCase().includes("mac")) {
        hint.textContent = "Ctrl K"
      }

      let links: HTMLAnchorElement[] = []
      let activeIndex = -1
      // Guards against a slower earlier query overwriting a newer one.
      let latestQuery = ""

      const setOpen = (open: boolean) => {
        panel.hidden = !open
        input.setAttribute("aria-expanded", String(open))
        if (!open) {
          activeIndex = -1
        }
      }

      const setStatus = (message: string) => {
        status.textContent = message
        status.hidden = message === ""
      }

      const setActive = (index: number) => {
        links.forEach((link, i) => {
          const active = i === index
          link.classList.toggle("is-active", active)
          if (active) {
            link.setAttribute("aria-selected", "true")
            link.scrollIntoView({ block: "nearest" })
          } else {
            link.removeAttribute("aria-selected")
          }
        })
        activeIndex = index
      }

      const resultLink = (
        href: string,
        className: string,
        build: (anchor: HTMLAnchorElement) => void,
      ) => {
        const anchor = document.createElement("a")
        anchor.href = href
        anchor.className = className
        anchor.setAttribute("role", "option")
        anchor.dataset.phCaptureAttributeCta = "docs-search-result"
        anchor.dataset.phCaptureAttributeCtaSection = section
        anchor.dataset.phCaptureAttributeCtaChannel = "internal"
        build(anchor)
        return anchor
      }

      const render = (entries: PagefindResultData[]) => {
        list.replaceChildren()

        for (const entry of entries) {
          const item = document.createElement("li")

          item.append(
            resultLink(entry.url, "docs-search-result", (anchor) => {
              if (entry.meta.secao) {
                const group = document.createElement("span")
                group.className = "docs-search-result-section"
                group.textContent = entry.meta.secao
                anchor.append(group)
              }

              const title = document.createElement("span")
              title.className = "docs-search-result-title"
              title.textContent = entry.meta.title ?? entry.url
              anchor.append(title)

              const excerpt = document.createElement("span")
              excerpt.className = "docs-search-result-excerpt"
              // Pagefind marks matched terms with <mark>, and the excerpt comes
              // from our own indexed content.
              excerpt.innerHTML = entry.excerpt
              anchor.append(excerpt)
            }),
          )

          // Headings that matched inside the page, for a direct jump.
          const subs = entry.sub_results
            .filter((sub) => sub.url !== entry.url)
            .slice(0, 3)

          if (subs.length > 0) {
            const subList = document.createElement("ul")
            subList.className = "docs-search-subresults"

            for (const sub of subs) {
              const subItem = document.createElement("li")
              subItem.append(
                resultLink(sub.url, "docs-search-subresult", (anchor) => {
                  anchor.textContent = sub.title
                }),
              )
              subList.append(subItem)
            }

            item.append(subList)
          }

          list.append(item)
        }

        links = [...list.querySelectorAll<HTMLAnchorElement>('[role="option"]')]
        activeIndex = -1
      }

      const search = async (query: string) => {
        const pagefind = await loadPagefind()

        if (!pagefind) {
          render([])
          setStatus(
            import.meta.env.DEV
              ? "A busca só funciona depois de `pnpm build`. Rode `pnpm preview` para testar."
              : "A busca está indisponível no momento.",
          )
          setOpen(true)
          return
        }

        const response = await pagefind.debouncedSearch(query, undefined, 200)

        // A newer keystroke already took over, or the search was debounced away.
        if (response === null || query !== latestQuery) return

        const entries = await Promise.all(
          response.results.slice(0, 8).map((result) => result.data()),
        )

        if (query !== latestQuery) return

        render(entries)
        setStatus(
          entries.length === 0 ? `Nenhum resultado para "${query}"` : "",
        )
        setOpen(true)
      }

      input.addEventListener("input", () => {
        const query = input.value.trim()
        latestQuery = query

        if (query.length < 2) {
          render([])
          setStatus("")
          setOpen(false)
          return
        }

        void search(query)
      })

      input.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          setOpen(false)
          input.blur()
          return
        }

        if (event.key === "Enter" && activeIndex >= 0) {
          event.preventDefault()
          links[activeIndex].click()
          return
        }

        const delta = { ArrowDown: 1, ArrowUp: -1 }[event.key]
        if (delta === undefined || links.length === 0) return

        event.preventDefault()
        if (panel.hidden) setOpen(true)
        setActive((activeIndex + delta + links.length) % links.length)
      })

      input.addEventListener("focus", () => {
        if (links.length > 0 || status.textContent) setOpen(true)
      })

      document.addEventListener("click", (event) => {
        if (!root.contains(event.target as Node)) setOpen(false)
      })

      document.addEventListener("keydown", (event) => {
        if (
          event.key.toLowerCase() === "k" &&
          (event.metaKey || event.ctrlKey)
        ) {
          event.preventDefault()
          input.focus()
          input.select()
        }
      })

      // Warms the wasm bundle so the first keystroke isn't the slow one.
      input.addEventListener("focus", () => void loadPagefind(), { once: true })
    })
</script>
